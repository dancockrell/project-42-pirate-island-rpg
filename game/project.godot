; Project 42 Godot 4 shell. Generated settings remain minimal and reviewable.
config_version=5

[application]
config/name="Project 42: Pirate Island RPG"
run/main_scene="res://scenes/shell/title.tscn"

[autoload]

CampaignSession="*res://scripts/campaign/campaign_session.gd"
CrashLog="*res://scripts/diagnostics/crash_log.gd"
GamePause="*res://scripts/campaign/game_pause.gd"
ContentPackRegistry="*res://scripts/content/pack_registry.gd"
Soundscape="*res://scripts/audio/soundscape.gd"
Atmosphere="*res://scripts/atmosphere/atmosphere.gd"
SceneFlow="*res://scripts/shell/scene_flow.gd"
InformationSurface="*res://scripts/surface/information_surface.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
; E11. Required by the macOS export, not a look decision: Godot refuses a
; universal or arm64 macOS export outright while this is off -- "Cannot export
; for universal or arm64 if ETC2 ASTC texture format is disabled." -- and
; universal is the only macOS binary format the official template archive can
; satisfy. It adds an ETC2/ASTC copy at import time and changes nothing about
; how the desktop renderer draws.
textures/vram_compression/import_etc2_astc=true

[input]
confirm={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[audio]
buses/default_bus_layout="res://default_bus_layout.tres"
