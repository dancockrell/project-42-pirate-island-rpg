[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://bin/windows/project42_sim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/project42_sim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/project42_sim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/project42_sim.linux.template_release.x86_64.so"
macos.debug = "res://bin/macos/project42_sim.macos.template_debug.x86_64.dylib"
macos.release = "res://bin/macos/project42_sim.macos.template_release.x86_64.dylib"
