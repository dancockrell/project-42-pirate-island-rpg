  "readableDescriptions": [
    {
      "id": "observation.black_beach.wreck",
      "text": "The Handsome Jack lies split along the black sand below the tide line. Her overlarge steam engine has torn the old tea cutter open, leaving copper pipe, wet timber and a climb toward shelter."
    },
    {
      "id": "observation.black_beach.boiler",
      "text": "The boiler housing is still warm enough to steam in the rain. Its cracked braces show why the cutter rolled badly in the typhoon, and a careful inspection can recover a useful part."
    }
  ],
