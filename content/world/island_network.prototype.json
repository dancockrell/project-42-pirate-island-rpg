  "nodes": [
    {"id": "network_node.black_beach", "roles": ["harbor", "wild"]},
    {"id": "network_node.coastal_estate", "roles": ["settlement", "strongpoint"]},
    {"id": "network_node.river_fork", "roles": ["hub", "chokepoint"]},
    {"id": "network_node.reception_terrace", "roles": ["strongpoint", "ritual"]},
    {"id": "network_node.old_canopy_road", "roles": ["wild", "resource"]},
    {"id": "network_node.smuggler_cove", "roles": ["harbor", "resource"]}
  ],
  "tethers": [
    {"id": "tether.black_beach.estate_road", "from": "network_node.black_beach", "to": "network_node.coastal_estate", "type": "road", "state": "open", "capacity": 2, "bidirectional": true},
    {"id": "tether.estate.river_supply", "from": "network_node.coastal_estate", "to": "network_node.river_fork", "type": "supply", "state": "open", "capacity": 3, "bidirectional": true},
    {"id": "tether.river.terrace_causeway", "from": "network_node.river_fork", "to": "network_node.reception_terrace", "type": "road", "state": "conditional", "capacity": 2, "bidirectional": true},
