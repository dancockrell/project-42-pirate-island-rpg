    {"id": "tether.canopy.terrace_ritual", "from": "network_node.old_canopy_road", "to": "network_node.reception_terrace", "type": "ritual", "state": "corrupted", "capacity": 1, "bidirectional": false},
    {"id": "tether.beach.cove_waterway", "from": "network_node.black_beach", "to": "network_node.smuggler_cove", "type": "waterway", "state": "open", "capacity": 3, "bidirectional": true},
    {"id": "tether.cove.canopy_hidden", "from": "network_node.smuggler_cove", "to": "network_node.old_canopy_road", "type": "hidden_route", "state": "hidden", "capacity": 1, "bidirectional": true},
    {"id": "tether.cove.river_sightline", "from": "network_node.smuggler_cove", "to": "network_node.river_fork", "type": "sightline", "state": "open", "capacity": 1, "bidirectional": false}
  ]
