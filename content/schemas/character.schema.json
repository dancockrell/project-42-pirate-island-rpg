{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.project42.character",
  "title": "Project 42 character record",
  "type": "object",
  "required": ["id", "displayName", "kind", "implementationOwner", "presentationOwner", "tags", "signatureWeaponId", "skillIds", "art", "metadata"],
  "properties": {
    "id": {"type": "string", "pattern": "^character\\.[a-z0-9_.-]+$"},
    "displayName": {"type": "string", "minLength": 1},
    "kind": {"enum": ["heroine", "protagonist", "named-person", "enemy"]},
    "implementationOwner": {"enum": ["rust-simulation", "authored-data"]},
    "presentationOwner": {"const": "godot-gdscript"},
    "tags": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "signatureWeaponId": {"type": "string", "pattern": "^weapon\\."},
    "skillIds": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "pattern": "^skill\\."}},
    "art": {
      "type": "object",
      "required": ["activeActorAssetId", "cardPortraitAssetId", "status", "accessibilityDescription"],
      "properties": {
        "activeActorAssetId": {"type": "string", "pattern": "^art\\."},
        "cardPortraitAssetId": {"type": "string", "pattern": "^art\\."},
        "status": {"enum": ["placeholder", "draft", "approved", "deprecated"]},
        "accessibilityDescription": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["source", "maturity", "releaseLegal", "notes"],
      "properties": {
        "source": {"type": "string"},
        "maturity": {"enum": ["prototype", "vertical-slice", "production", "locked"]},
        "releaseLegal": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
