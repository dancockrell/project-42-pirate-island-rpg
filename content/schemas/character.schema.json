{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.project42.character",
  "title": "Project 42 character record",
  "type": "object",
  "required": ["id", "displayName", "kind", "implementationOwner", "presentationOwner", "tags", "signatureWeaponId", "skillIds", "art", "metadata"],
  "properties": {
    "id": {"type": "string", "pattern": "^character\\.[a-z0-9_.-]+$"},
    "displayName": {"type": "string", "minLength": 1},
    "kind": {"enum": ["heroine", "protagonist", "named-person", "enemy"]},
    "implementationOwner": {"enum": ["rust-simulation", "authored-data"]},
    "presentationOwner": {"const": "godot-gdscript"},
    "tags": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "signatureWeaponId": {"type": "string", "pattern": "^weapon\\."},
    "skillIds": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"type": "string", "pattern": "^skill\\."}},
    "island": {
      "description": "What the island simulation needs to place this character as a person on the board. Present only for characters a scenario pack may place; the simulation reads this and nothing else about identity, so a name or history lives here once rather than being repeated in Rust.",
      "type": "object",
      "required": ["boardName", "sex", "age", "backstory"],
      "properties": {
        "boardName": {"type": "string", "minLength": 1},
        "sex": {"enum": ["male", "female"]},
        "age": {"type": "integer", "minimum": 1, "maximum": 120},
        "backstory": {"type": "string", "minLength": 1},
        "recruitmentOffer": {"description": "What she says when she asks to come along. The persona pools supply this for generated women; an authored notable supplies her own, because the recruitment verb reads the same field for both and a woman without one can never be asked.", "type": "string", "minLength": 1},
        "companionResponse": {"description": "What she says once she is standing with him, the authored counterpart of a persona pool's companion_responses.", "type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "art": {
      "type": "object",
      "required": ["activeActorAssetId", "cardPortraitAssetId", "status", "accessibilityDescription"],
      "properties": {
        "activeActorAssetId": {"type": "string", "pattern": "^art\\."},
        "cardPortraitAssetId": {"type": "string", "pattern": "^art\\."},
        "status": {"enum": ["placeholder", "draft", "approved", "deprecated"]},
        "accessibilityDescription": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["source", "maturity", "releaseLegal", "notes"],
      "properties": {
        "source": {"type": "string"},
        "maturity": {"enum": ["prototype", "vertical-slice", "production", "locked"]},
        "releaseLegal": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
