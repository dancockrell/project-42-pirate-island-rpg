{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.project42.adventure_site",
  "title": "Faction structure and deterministic adventure-site definition",
  "type": "object",
  "required": ["id", "kind", "factionId", "archetypeId", "level", "footprint", "hooks", "production", "generation", "loot", "metadata"],
  "properties": {
    "id": {"type": "string", "pattern": "^site\\.[a-z0-9_.-]+$"},
    "kind": {"const": "faction_adventure_site"},
    "factionId": {"type": "string", "pattern": "^faction\\."},
    "archetypeId": {"type": "string", "pattern": "^site_archetype\\."},
    "level": {"type": "integer", "minimum": 1, "maximum": 5},
    "footprint": {
      "type": "object",
      "required": ["gridStandard", "modules", "containmentRule", "containedBounds", "containedElements"],
      "properties": {
        "gridStandard": {"const": "map_cube_v1"},
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["origin", "size"],
            "properties": {
              "origin": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "items": false},
              "size": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}
            },
            "additionalProperties": false
          }
        },
        "containmentRule": {"const": "all_geometry_collision_selection_props_and_hooks_inside_module_union"},
        "containedBounds": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["kind", "moduleIndex", "normalizedMin", "normalizedMax"],
            "properties": {
              "kind": {"enum": ["visual", "collision", "selection"]},
              "moduleIndex": {"type": "integer", "minimum": 0},
              "normalizedMin": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false},
              "normalizedMax": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false}
            },
            "additionalProperties": false
          }
        },
        "containedElements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "moduleIndex", "normalizedPosition"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"enum": ["visual_bounds", "collision_bounds", "selection_bounds", "spawn_point", "tether_socket", "influence_hook", "state_hook", "prop_anchor"]},
              "moduleIndex": {"type": "integer", "minimum": 0},
              "normalizedPosition": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "required": ["actorSpawnPointIds", "tetherSocketIds", "influenceHookIds", "stateHookIds"],
      "properties": {
        "actorSpawnPointIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "tetherSocketIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "influenceHookIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "stateHookIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "required": ["queueIds", "spawnRuleIds", "rallyPointId", "allowedActorKinds", "dispatchOwner"],
      "properties": {
        "queueIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^production_queue\\."}},
        "spawnRuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^spawn_rule\\."}},
        "rallyPointId": {"type": "string", "pattern": "^rally\\."},
        "allowedActorKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["worker", "resident", "vendor", "specialist", "soldier", "monster", "named_hero", "supernatural"]}},
        "dispatchOwner": {"const": "faction_ai"}
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["revision", "seedInputs", "durableUntil"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "seedInputs": {"const": ["world_seed", "faction_id", "structure_instance_id", "archetype_id", "structure_level", "generation_revision"]},
        "durableUntil": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["upgrade", "capture", "damage_state_change", "corruption", "declared_refresh"]}}
      },
      "additionalProperties": false
    },
    "loot": {
      "type": "object",
      "required": ["factionFamily", "archetypeFamily", "levelBand", "higherLevelImprovesExpectedValue"],
      "properties": {
        "factionFamily": {"type": "string", "minLength": 1},
        "archetypeFamily": {"type": "string", "minLength": 1},
        "levelBand": {"type": "integer", "minimum": 1, "maximum": 5},
        "higherLevelImprovesExpectedValue": {"const": true}
      },
      "additionalProperties": true
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
